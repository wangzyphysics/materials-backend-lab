{
  "name": "calypso-real-materials-backend-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "extract": "python3 scripts/extract-sample.py ../results-0430",
    "db:start": "node scripts/local-postgres.mjs start",
    "db:stop": "node scripts/local-postgres.mjs stop",
    "db:status": "node scripts/local-postgres.mjs status",
    "import": "node scripts/import.mjs",
    "verify": "node scripts/verify.mjs",
    "serve": "node src/server.mjs",
    "export": "node scripts/export.mjs",
    "sql": "node scripts/sql.mjs",
    "platform:serve": "node --experimental-strip-types src/platform/server.mjs",
    "platform:bootstrap": "node --experimental-strip-types scripts/platform-bootstrap.mjs",
    "platform:test": "node --experimental-strip-types --test tests/platform.test.mjs",
    "platform:stats": "node --experimental-strip-types scripts/platform-statistics.mjs",
    "platform:showcase": "node --experimental-strip-types scripts/seed-showcase.mjs",
    "platform:domain:test": "node --experimental-strip-types --test tests/domain.test.mjs tests/runtime-config.test.mjs tests/hierarchy.test.ts",
    "package:backend": "node scripts/package-backend.mjs",
    "verify:independent": "node --experimental-strip-types scripts/verify-independent.mjs",
    "data:ingest": "node --experimental-strip-types scripts/ingestion.mjs",
    "ingestion:test": "node --experimental-strip-types --test tests/ingestion.test.mjs",
    "materials:detail:test": "node --experimental-strip-types --test tests/material-detail.test.mjs",
    "platform:all:test": "node --experimental-strip-types --test --test-concurrency=1 tests/platform.test.mjs tests/domain.test.mjs tests/runtime-config.test.mjs tests/hierarchy.test.ts tests/ingestion.test.mjs tests/material-detail.test.mjs"
  },
  "dependencies": {
    "pg": "8.16.3",
    "zod": "3.25.76"
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "18.4.0-beta.17"
  }
}
